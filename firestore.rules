rules_version = '2';

// Pro Placement — Player Hub. Firestore security rules.
//
// THIS FILE IS THE SECURITY OF THE APP. Not the login screen, not the React code.
// Before this existed, the database was open: anyone on the internet could read every
// player's record, including their password in plain text. Everything below exists to
// make sure that can never be true again.
//
// The three ideas:
//   1. A player can read and write HIS OWN record and nothing else. "His own" means the
//      record whose `authUid` equals the id Firebase Auth gave him. Not his email — email
//      lookups are what made the old version readable by everyone.
//   2. An admin is someone with a document at `admins/{their uid}`. That document can only
//      be created in the Firebase console. No code path in the app can grant admin.
//   3. Admin notes live in their OWN collection, never on the player's record. Firestore
//      hands back whole documents — it cannot hide one field from the person reading it —
//      so a note kept on the player's record is a note the player can read.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------------------------------------------------------------- admins
    // Read-only to the person it names, listable by admins, writable by NOBODY.
    // Add an admin: Firebase console > Firestore > collection `admins` > document id =
    // that person's Auth uid. Remove one: delete the document.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------- adminNotes
    // What the coach writes about a player. Admins only, in every direction.
    // The player must never be able to read these, which is why they are not on his record.
    match /adminNotes/{playerId} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------ playerFiles
    //
    // The passport photos, the CV and the headshot. One document per file, id
    // `<owner uid>__<slot>`, holding the file itself as a base64 string.
    //
    // Why here and not Firebase Storage: Storage needs the paid Blaze plan and this project
    // stays on the free one. It turns out to be the safer place anyway. A Storage download
    // link carries its own access token and keeps working for anyone who ever sees it,
    // whatever the rules say afterwards. A document has no link at all, so these rules are
    // consulted on every single read of a passport, forever.
    //
    // They are a separate collection, never fields on the player's record, so that the
    // coach's list can draw thirty names without dragging thirty passport photos with it.
    match /playerFiles/{fileId} {

      // The id carries the owner, so a missing file reads as "not there" instead of as a
      // permission error, and nobody can probe for someone else's.
      function mineById() {
        return signedIn() && fileId.split('__')[0] == request.auth.uid;
      }

      function validFile() {
        return request.resource.data.ownerUid == request.auth.uid
          && fileId == request.auth.uid + '__' + request.resource.data.slot
          && request.resource.data.slot in ['passportOne', 'passportTwo', 'cv', 'headshot']
          && request.resource.data.data is string
          // A Firestore document tops out at 1 MiB including field names. The client shrinks
          // photos to fit; this is the wall that makes that true rather than hoped for.
          && request.resource.data.data.size() <= 900000
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.type is string
          && request.resource.data.keys()
               .hasOnly(['ownerUid', 'slot', 'name', 'type', 'data', 'savedAt']);
      }

      allow get: if isAdmin() || mineById();
      allow list: if isAdmin();
      allow create, update: if signedIn() && mineById() && validFile();
      allow delete: if isAdmin() || mineById();
    }

    // ---------------------------------------------------------------- players
    match /players/{playerId} {

      // The record belongs to the person signed in.
      function mine() {
        return signedIn()
          && resource != null
          && resource.data.authUid == request.auth.uid;
      }

      // The only fields a record may ever contain, whoever is writing.
      // Kept in step with PLAYER_OWNED_KEYS in src/services/db.js.
      function sectionKeys() {
        return [
          'profile', 'fullGames', 'topThreeClips', 'skillClips', 'photos', 'driveFolder',
          'identity', 'playerCard', 'contact', 'deliverables', 'platforms'
        ];
      }

      // Three fields must never exist on a player record AFTER any write:
      //   `password` and `role` — the two that caused the original leak;
      //   `adminNotes` — because a note on the player's record is a note he can read.
      // This is deliberately strict: it is a condition on the RESULT, not on the change.
      // So the first admin write to an old record must clean it (both admin actions in
      // src/services/db.js do exactly that: the notes are copied to the `adminNotes`
      // collection, then all three fields are deleted). After the migration no record
      // carries them and this is invisible.
      function noSecrets() {
        return !('password' in request.resource.data)
          && !('role' in request.resource.data)
          && !('adminNotes' in request.resource.data);
      }

      // ------------------------------------------------- the verified email

      // `authEmail` is the ONE field on this record that cannot be made up.
      //
      // Why it exists: carrying an old record across matches on an email address. If that
      // address came from `profile.email` — which the player writes himself — then anyone
      // could type a team-mate's address into his own profile and wait for the coach to
      // press "Bring across", and the coach would have handed him another player's footage.
      // Registering with someone else's address is not enough either: Firebase lets you
      // create an account for any address without proving you can read that inbox.
      //
      // So this field may only ever be set to the address Firebase itself says you are
      // signed in as, AND only once Firebase says you have clicked the link in it. An
      // attacker can hold an account on a victim's address; he cannot verify it.
      function myVerifiedEmail() {
        return request.auth.token.email_verified == true
          && request.resource.data.authEmail == request.auth.token.email;
      }

      function authEmailUntouchedOrMine() {
        return !('authEmail' in request.resource.data.diff(resource.data).affectedKeys())
          || myVerifiedEmail();
      }

      // ------------------------------------------------------ shape of a record
      // The keys were always restricted; the VALUES were not, so a player could store a map
      // where the admin list expects a name and take the coach's dashboard down with it.
      function strOk(m, k) { return !(k in m) || m[k] is string; }

      function profileOk() {
        return !('profile' in request.resource.data)
          || (request.resource.data.profile is map
              && strOk(request.resource.data.profile, 'fullName')
              && strOk(request.resource.data.profile, 'email')
              && strOk(request.resource.data.profile, 'position')
              && strOk(request.resource.data.profile, 'createdAt')
              // lastSeenAt is a server timestamp now; older records hold an ISO string.
              && (!('lastSeenAt' in request.resource.data.profile)
                  || request.resource.data.profile.lastSeenAt is timestamp
                  || request.resource.data.profile.lastSeenAt is string));
      }

      function listOk(k) {
        return !(k in request.resource.data) || request.resource.data[k] is list;
      }

      function mapOk(k) {
        return !(k in request.resource.data) || request.resource.data[k] is map;
      }

      function wellFormed() {
        return profileOk()
          && listOk('fullGames') && listOk('topThreeClips')
          && mapOk('skillClips') && mapOk('photos') && mapOk('driveFolder')
          // The five hub sections. Same reason as the footage ones: the coach's page renders
          // every player at once, so one record holding a string where a map belongs would
          // take the whole list down.
          && mapOk('identity') && mapOk('playerCard') && mapOk('contact')
          && mapOk('deliverables') && mapOk('platforms') && mapOk('coachSignOff')
          && (!('authEmail' in request.resource.data) || request.resource.data.authEmail is string);
      }

      // ------------------------------------------------- what the COACH owns
      //
      // `coachSignOff` holds the two things the coach says about a player: that the reel is
      // ready to send, and the address of the proof page clubs get. Both used to live inside
      // `deliverables`, which the player owns, so he could tick his own coach approval and
      // swap the link to the page clubs are sent. Nothing automatic keyed off either, but a
      // screen that says "your coach has checked this video" has to be telling the truth.
      //
      // A separate top-level key rather than a nested guard: the player writes whole sections
      // at a time, so anything he owns is something he can replace. This also stops his save
      // erasing a sign-off the coach made while he was typing.
      function coachKeys() { return ['coachSignOff']; }

      // What a player may change on his own record. `coachSignOff` is deliberately absent.
      function ownedKeysOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(sectionKeys().concat(['authEmail', 'updatedAt']));
      }

      // `updatedAt` is what the coach's list reads as "he added something", so a player must
      // not be able to hand-write it. serverTimestamp() resolves to request.time here, so
      // this passes for every honest write and refuses a made-up one.
      function updatedAtOk() {
        return !('updatedAt' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.updatedAt == request.time;
      }

      // What an admin may change: the sections (so he can repair a record and carry an old
      // one across) and the bookkeeping of that migration. NOT `authUid` — ownership is not
      // his to reassign — and not `adminNotes`, which live in their own collection now.
      function adminKeysOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(sectionKeys().concat(coachKeys()).concat([
            'password', 'role', 'adminNotes',   // only ever removed, enforced by noSecrets()
            'linkedAt', 'mergedInto', 'updatedAt'
          ]));
      }

      // A new record is filed under the owner's own uid and may contain NOTHING but the
      // fields named here. An unknown field is refused rather than quietly stored.
      function validNewRecord() {
        return request.auth.uid == playerId
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.keys()
               .hasOnly(sectionKeys().concat(['authUid', 'authEmail', 'updatedAt']))
          && request.resource.data.updatedAt == request.time
          // A brand-new account has not verified its address yet, so `authEmail` is normally
          // absent here and written later. If it IS present it must already be the real one.
          && (!('authEmail' in request.resource.data) || myVerifiedEmail());
      }

      // Reading his own record by id is allowed even before it exists, so a fresh signup
      // gets a clean "not found" instead of a permission error.
      allow get: if isAdmin()
                 || (signedIn() && request.auth.uid == playerId)
                 || mine();

      // Only ever used as: where('authUid', '==', <my uid>). A wider query returns
      // documents this rule refuses, so the server rejects the whole query.
      allow list: if isAdmin() || mine();

      allow create: if signedIn() && validNewRecord() && noSecrets() && wellFormed();

      allow update: if noSecrets()
                    && wellFormed()
                    && authEmailUntouchedOrMine()
                    && updatedAtOk()
                    && ((mine() && ownedKeysOnly())
                        || (isAdmin() && adminKeysOnly()));

      // Records are never destroyed from the app. Client data is not disposable.
      allow delete: if false;
    }

    // Anything not named above is closed. (Firestore ORs the allow rules, so this cannot
    // take away access granted above — it is here to state the default out loud.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
