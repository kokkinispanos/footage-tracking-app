rules_version = '2';

// Pro Placement — Player Hub. Firebase Storage security rules.
//
// This is where the passport, the CV and the headshot live. An identity document must
// never be a public URL, so nothing here is readable without being signed in as its owner
// or as an admin.
//
// Everything else — full games, clips, photos for the editor — stays as Google Drive or
// YouTube links in Firestore, on purpose: the editor needs to open them in Drive.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The ONLY four names a player may write, and no extension on any of them.
    //
    // Not `{anything=**}`. Two reasons, both real: a free path lets one player fill the
    // bucket with a million small objects, and a free filename is a string an attacker
    // controls that later gets rendered somewhere. A fixed slot has neither problem, and
    // uploading again simply replaces what is there. The real filename and type are kept
    // in Firestore, where the rules already check their shape.
    function isKnownSlot(slot) {
      return slot in ['passportOne', 'passportTwo', 'cv', 'headshot'];
    }

    // The browser decides what it calls a file, so this is a courtesy check, not a
    // guarantee. It stops the honest mistake (a .mov named .pdf) and the size cap is what
    // actually protects the bucket.
    function allowedFile() {
      return request.resource.size > 0
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    match /players/{uid}/{slot} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && isKnownSlot(slot) && allowedFile();

      // `request.resource` is null on a delete, so this needs its own rule rather than
      // falling under the write above.
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Anything outside those four slots is closed, including deeper paths under a
    // player's own folder.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
