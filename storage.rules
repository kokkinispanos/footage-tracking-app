rules_version = '2';

// Pro Placement — Player Hub. Firebase Storage security rules.
//
// This is where the passport, the CV and the headshot will live (stage 3).
// An identity document must never be a public URL, so nothing here is readable
// without being signed in as its owner or as an admin.
//
// Everything else — full games, clips, photos for the editor — stays as Google Drive
// or YouTube links in Firestore, on purpose: the editor needs to open them in Drive.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // One folder per player, named with his Auth uid: players/<uid>/passport.pdf etc.
    match /players/{uid}/{allPaths=**} {

      allow read: if isOwner(uid) || isAdmin();

      // Images and PDFs only, 15 MB ceiling. A player cannot upload into another
      // player's folder because the path itself carries the owner's uid.
      allow write: if isOwner(uid)
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');

      allow delete: if isOwner(uid) || isAdmin();
    }

    // Anything outside a player's own folder is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
